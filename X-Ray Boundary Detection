import numpy as np
import matplotlib.pyplot as plt
from PIL import Image
import requests
from io import BytesIO

# ==========================================
# 1. CORE MATHEMATICAL OPERATION: 2D CONVOLUTION
# ==========================================
def convolve2d(image, kernel):
    """
    Performs 2D spatial convolution of an image with a given kernel.
    Pads image borders with edge replication.
    """
    img_h, img_w = image.shape
    k_h, k_w = kernel.shape
    pad_h, pad_w = k_h // 2, k_w // 2

    # Pad image to preserve dimensions
    padded = np.pad(image, ((pad_h, pad_h), (pad_w, pad_w)), mode='edge')
    output = np.zeros_like(image, dtype=np.float64)

    # Flip kernel 180 degrees (formal definition of convolution)
    kernel_flipped = np.flipud(np.fliplr(kernel))

    # Apply sliding window sum of element-wise products
    for i in range(img_h):
        for j in range(img_w):
            region = padded[i:i + k_h, j:j + k_w]
            output[i, j] = np.sum(region * kernel_flipped)

    return output


# ==========================================
# 2. SOBEL OPERATOR (FROM SCRATCH)
# ==========================================
def sobel_filter(image):
    """
    Computes horizontal and vertical spatial derivatives,
    gradient magnitude, and gradient direction.
    """
    # Sobel kernels approximating continuous partial derivatives
    Kx = np.array([
        [-1, 0, 1],
        [-2, 0, 2],
        [-1, 0, 1]
    ], dtype=np.float64)

    Ky = np.array([
        [ 1,  2,  1],
        [ 0,  0,  0],
        [-1, -2, -1]
    ], dtype=np.float64)

    # Convolve image with derivative masks
    Gx = convolve2d(image, Kx)
    Gy = convolve2d(image, Ky)

    # Compute Euclidean gradient magnitude: G = sqrt(Gx^2 + Gy^2)
    magnitude = np.hypot(Gx, Gy)
    # Normalize to 0-255 range
    if magnitude.max() > 0:
        magnitude = (magnitude / magnitude.max()) * 255.0

    # Gradient orientation in radians
    theta = np.arctan2(Gy, Gx)

    return magnitude, theta


# ==========================================
# 3. CANNY EDGE DETECTOR (FROM SCRATCH)
# ==========================================
def gaussian_kernel(size=5, sigma=1.4):
    """Generates a discrete 2D Gaussian smoothing kernel."""
    k = size // 2
    x, y = np.mgrid[-k:k+1, -k:k+1]
    normal = 1.0 / (2.0 * np.pi * sigma**2)
    g = np.exp(-((x**2 + y**2) / (2.0 * sigma**2))) * normal
    return g / g.sum()

def non_maximum_suppression(magnitude, theta):
    """
    Thins thick edges by retaining only local maxima along the gradient direction.
    """
    h, w = magnitude.shape
    suppressed = np.zeros((h, w), dtype=np.float64)

    # Convert angle to degrees in range [0, 180)
    angle = np.rad2deg(theta) % 180

    for i in range(1, h - 1):
        for j in range(1, w - 1):
            q, r = 255.0, 255.0
            deg = angle[i, j]

            # 0 degrees: Horizontal boundary (vertical gradient)
            if (0 <= deg < 22.5) or (157.5 <= deg <= 180):
                q = magnitude[i, j + 1]
                r = magnitude[i, j - 1]
            # 45 degrees: Diagonal /
            elif 22.5 <= deg < 67.5:
                q = magnitude[i + 1, j - 1]
                r = magnitude[i - 1, j + 1]
            # 90 degrees: Vertical boundary (horizontal gradient)
            elif 67.5 <= deg < 112.5:
                q = magnitude[i + 1, j]
                r = magnitude[i - 1, j]
            # 135 degrees: Diagonal \
            elif 112.5 <= deg < 157.5:
                q = magnitude[i - 1, j - 1]
                r = magnitude[i + 1, j + 1]

            # Suppress non-peaks
            if (magnitude[i, j] >= q) and (magnitude[i, j] >= r):
                suppressed[i, j] = magnitude[i, j]
            else:
                suppressed[i, j] = 0

    return suppressed

def double_threshold(image, low_ratio=0.08, high_ratio=0.20):
    """Partitions pixels into strong, weak, and non-edge categories."""
    high_threshold = image.max() * high_ratio
    low_threshold = high_threshold * low_ratio

    strong_val, weak_val = 255, 75
    res = np.zeros_like(image, dtype=np.uint8)

    strong_i, strong_j = np.where(image >= high_threshold)
    weak_i, weak_j = np.where((image >= low_threshold) & (image < high_threshold))

    res[strong_i, strong_j] = strong_val
    res[weak_i, weak_j] = weak_val

    return res, weak_val, strong_val

def edge_tracking_hysteresis(image, weak_val=75, strong_val=255):
    """
    Retains weak edges only if connected to a strong edge via 8-connectivity.
    """
    h, w = image.shape
    for i in range(1, h - 1):
        for j in range(1, w - 1):
            if image[i, j] == weak_val:
                # Check 8-neighborhood for any strong pixel
                neighborhood = image[i - 1:i + 2, j - 1:j + 2]
                if np.any(neighborhood == strong_val):
                    image[i, j] = strong_val
                else:
                    image[i, j] = 0
    return image

def canny_detector(image, low_ratio=0.08, high_ratio=0.20):
    """Executes the full 5-stage Canny edge detection pipeline."""
    # Stage 1: Gaussian Smoothing
    gauss = gaussian_kernel(size=5, sigma=1.4)
    smoothed = convolve2d(image, gauss)

    # Stage 2: Gradient Calculation via Sobel
    magnitude, theta = sobel_filter(smoothed)

    # Stage 3: Non-Maximum Suppression (Thinning)
    suppressed = non_maximum_suppression(magnitude, theta)

    # Stage 4: Double Thresholding
    thresholded, weak_val, strong_val = double_threshold(suppressed, low_ratio, high_ratio)

    # Stage 5: Hysteresis Edge Tracking
    final_edges = edge_tracking_hysteresis(thresholded, weak_val, strong_val)

    return final_edges


# ==========================================
# 4. EXECUTION & VISUALIZATION (DYNAMIC INPUT)
# ==========================================
try:
    # Prompt user for an image URL
    url = input("Please enter the image URL: ").strip()
    if not url:
        # Default fallback image if none provided
        url = "https://raw.githubusercontent.com/smahesh29/COVID-19-Detection-through-Chest-X-Ray/master/test_set/patient2.jpg"
        print(f"No URL entered. Using default fallback: {url}")

    # Fetch image using requests & PIL
    response = requests.get(url, timeout=15)
    pil_img = Image.open(BytesIO(response.content)).convert('L')

    # Resize (e.g., 256x256) so loop-based convolution completes in ~2 seconds
    pil_img = pil_img.resize((256, 256))
    raw_image = np.array(pil_img, dtype=np.float64)

    # Run algorithms
    sobel_res, _ = sobel_filter(raw_image)
    canny_res = canny_detector(raw_image, low_ratio=0.08, high_ratio=0.22)

    # Plotting
    plt.figure(figsize=(15, 5))
    plt.subplot(1, 3, 1)
    plt.imshow(raw_image, cmap='gray')
    plt.title("Original (256x256)")
    plt.axis("off")

    plt.subplot(1, 3, 2)
    plt.imshow(sobel_res, cmap='gray')
    plt.title("Manual Sobel Magnitude")
    plt.axis("off")

    plt.subplot(1, 3, 3)
    plt.imshow(canny_res, cmap='gray')
    plt.title("Manual Canny Pipeline")
    plt.axis("off")

    plt.tight_layout()
    plt.show()

except Exception as e:
    print(f"An error occurred while loading or processing the image: {e}")
